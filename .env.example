# FrontierLab environment variables (reference template)
#
# Copy to .env for local use and NEVER commit real keys. .env is git-ignored.
# The app does not load .env automatically: export these variables in your
# shell, or set them in your host's secret settings (HF Space secrets,
# GitHub Actions secrets). GitHub Secrets do NOT reach Hugging Face Spaces.
#
# Nothing below is required for the Synthetic audit demonstration or the
# Live Europe PMC metadata mode. Every model-backed path is off by default.

# --- Meta Muse Glimmer via NVIDIA NIM -------------------------------------
# Required for any NVIDIA-backed mode or trial script.
NVIDIA_API_KEY=
# Opt-in (set to YES): enables the "Live Europe PMC + Meta via NVIDIA"
# research mode in app.py, and is required by the extraction and
# continuation trial scripts. Read by frontierlab/research_backend.py.
FRONTIERLAB_NIM_RESEARCH=

# --- Publisher discovery (Springer Nature) ---------------------------------
# Optional: only the three-source discovery and Springer smoke scripts need
# these. The Springer Nature "Meta API" is a bibliographic metadata API,
# unrelated to Meta Platforms model inference.
SPRINGER_NATURE_META_API_KEY=
SPRINGER_NATURE_OA_API_KEY=
# Accepted fallback names if the variables above are unset:
# META_API_KEY=            (fallback for SPRINGER_NATURE_META_API_KEY)
# Open_Access_API=         (fallback for SPRINGER_NATURE_OA_API_KEY)

# --- Bounded trial-script opt-ins (set to YES only for a deliberate run) --
# Each run makes real, budgeted NVIDIA NIM calls with no automatic retries.
# scripts/smoke_nvidia_muse.py, smoke_meta_json.py and smoke_meta_pilot.py;
# also gates the NVIDIA client in frontierlab/nvidia_muse.py.
FRONTIERLAB_NVIDIA_TRIAL=
# scripts/smoke_meta_json.py (also needs FRONTIERLAB_NVIDIA_TRIAL=YES)
FRONTIERLAB_META_JSON_TRIAL=
# scripts/smoke_meta_pilot.py (also needs FRONTIERLAB_NVIDIA_TRIAL=YES)
FRONTIERLAB_META_PILOT_TRIAL=
# scripts/nim_research_extract_trial.py (also needs FRONTIERLAB_NIM_RESEARCH=YES)
FRONTIERLAB_EXTRACTION_TRIAL=
# scripts/nim_research_continue_trial.py (also needs FRONTIERLAB_NIM_RESEARCH=YES)
FRONTIERLAB_CONTINUATION_TRIAL=

# --- Local open-weight model -----------------------------------------------
# Opt-in (set to YES): lets scripts/start_muse_local.sh download the ~17 GB
# Muse Glimmer GGUF checkpoint for llama.cpp at 127.0.0.1:8080.
FRONTIERLAB_DOWNLOAD_OK=

# --- Hugging Face deployment (scripts/deploy_hf_space.py) ------------------
# Opt-in (set to YES) plus a Hub token with write access to the existing Space.
# Normally set only inside the manual deploy-hf-space GitHub workflow.
FRONTIERLAB_HF_DEPLOY=
HF_TOKEN1=

# --- Set automatically by GitHub Actions (do not set by hand) -------------
# Recorded in run receipts by scripts/smoke_nvidia_muse.py and
# scripts/deploy_hf_space.py:
# GITHUB_SHA=
# GITHUB_RUN_ID=
# GITHUB_RUN_ATTEMPT=
